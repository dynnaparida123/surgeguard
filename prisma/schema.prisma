generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  MUNICIPAL
  RESCUE
  CITIZEN
}

enum ReportStatus {
  PENDING_AI
  VERIFIED
  REJECTED
  DUPLICATE
  NEEDS_REVIEW
  RESOLVED
}

enum HazardSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuthenticityStatus {
  REAL
  LIKELY_REAL
  SUSPICIOUS
  LIKELY_AI_GENERATED
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  name             String?
  username         String?         @unique
  role             Role            @relation(fields: [roleId], references: [id])
  roleId           String
  avatar           String?
  points           Int             @default(0)
  trustScore       Int             @default(0)
  verifiedReports  Int             @default(0)
  acceptedReports  Int             @default(0)
  rejectedReports  Int             @default(0)
  reports          CitizenReport[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Role {
  id    String   @id @default(cuid())
  name  RoleName @unique
  users User[]
}

model CitizenReport {
  id                     String             @id @default(cuid())
  user                   User?              @relation(fields: [userId], references: [id])
  userId                 String?
  imageUrl               String?
  latitude               Float?
  longitude              Float?
  locationAccuracy       Float?
  description            String?
  hazardType             String?
  severity               HazardSeverity?
  riskScore              Int?
  authenticityStatus    AuthenticityStatus?
  authenticityConfidence Float?
  aiVerificationStatus   String?
  aiVerificationReason   String?
  duplicateStatus        String?
  status                 ReportStatus       @default(PENDING_AI)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  verifiedAt             DateTime?
  verificationSource     String?
  reportVerifications    ReportVerification[]
  potholeAnalysis        PotholeAnalysis?
}

model ReportVerification {
  id      String        @id @default(cuid())
  report  CitizenReport @relation(fields: [reportId], references: [id])
  reportId String
  verdict String
  notes   String?
  createdAt DateTime @default(now())
}

model PotholeAnalysis {
  id                         String        @id @default(cuid())
  report                     CitizenReport @relation(fields: [reportId], references: [id])
  reportId                   String        @unique
  isRelevantRoadHazard       Boolean
  hazardType                 String
  authenticityStatus        AuthenticityStatus
  authenticityConfidence     Float
  severityLevel              HazardSeverity
  severityConfidence         Float
  estimatedRisk             Int
  visualEvidence            String[]
  reasoningFactors          String[]
  needsHumanReview          Boolean
  createdAt                 DateTime      @default(now())
}

model Infrastructure {
  id                String   @id @default(cuid())
  name              String
  type              String
  latitude          Float
  longitude         Float
  riskScore         Int
  floodRisk         Int
  accessibility     Int
  lastVerified      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RescueTeam {
  id          String   @id @default(cuid())
  name        String
  team        String
  role        String
  latitude    Float
  longitude   Float
  status      String
  availability String
  lastUpdated DateTime
  createdAt   DateTime @default(now())
}

model RescueWorker {
  id          String   @id @default(cuid())
  name        String
  team        String
  role        String
  latitude    Float
  longitude   Float
  status      String
  availability String
  lastUpdated DateTime
  createdAt   DateTime @default(now())
}

model WeatherObservation {
  id             String   @id @default(cuid())
  source         String
  location       String
  temperature    Float?
  rainfall       Float?
  windSpeed      Float?
  windDirection  Int?
  pressure       Float?
  humidity       Float?
  cloudCoverage  Float?
  stormStatus    String?
  cycloneStatus  String?
  sourceTimestamp DateTime
  ingestedAt     DateTime @default(now())
  lastUpdated    DateTime @updatedAt
}

model SatelliteObservation {
  id             String   @id @default(cuid())
  source         String
  dataset        String
  geometry       String?
  value          Float?
  unit           String?
  confidence     Float?
  sourceTimestamp DateTime
  ingestedAt     DateTime @default(now())
  lastUpdated    DateTime @updatedAt
}

model Cyclone {
  id              String   @id @default(cuid())
  name            String
  category        Int
  windSpeed       Float
  pressure        Int
  positionLat     Float
  positionLng     Float
  movementSpeed   Float?
  direction       String?
  forecastTime    DateTime?
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RiskZone {
  id          String   @id @default(cuid())
  name        String
  lat         Float
  lng         Float
  riskScore   Int
  type        String
  source      String
  createdAt   DateTime @default(now())
}

model Alert {
  id             String   @id @default(cuid())
  title          String
  description    String
  severity       String
  recommendedAction String?
  metadata       Json?
  createdAt      DateTime @default(now())
}

model PointsTransaction {
  id          String   @id @default(cuid())
  userId      String
  type        String
  points      Int
  reason      String
  createdAt   DateTime @default(now())
}

model LeaderboardSnapshot {
  id          String   @id @default(cuid())
  userId      String
  rank        Int
  points      Int
  verifiedReports Int
  accuracy    Float
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  actor       String
  action      String
  target      String?
  details     String?
  createdAt   DateTime @default(now())
}
